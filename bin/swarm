#!/usr/bin/env bash
set -euo pipefail

# Synapse Swarm
# 使い方: bin/swarm [プロジェクトのパス]

SYNAPSE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TARGET="${1:-$(pwd)}"
SESSION="swarm-$(date +%H%M%S)"

if ! command -v cmux &>/dev/null; then
    echo "エラー: cmux が必要です"
    exit 1
fi
if ! command -v claude &>/dev/null; then
    echo "エラー: Claude CLI が必要です"
    exit 1
fi

ORCH_CMD="SYNAPSE_ROOT=$(printf '%q' "$SYNAPSE_ROOT") TARGET=$(printf '%q' "$TARGET") SESSION=$(printf '%q' "$SESSION") bash $(printf '%q' "${SYNAPSE_ROOT}/bin/_orchestrate")"

# ワークスペースを作成（出力: "OK <UUID>"）
result=$(cmux new-workspace --command "$ORCH_CMD")
WS_UUID=$(echo "$result" | awk '{print $2}')

if [[ -z "$WS_UUID" ]]; then
    echo "エラー: ワークスペースの作成に失敗しました（出力: ${result}）"
    exit 1
fi

cmux rename-workspace --workspace "$WS_UUID" "swarm" 2>/dev/null || true
echo "ワークスペース 'swarm' を開きました（cmux に切り替えてください）"
